:root{
  --bg:#07060a;
  --ink:#ece8e0;
  --muted:#8c877e;
  --line:rgba(201,167,90,.22);
  --line-soft:rgba(201,167,90,.12);
  --gold-1:#6f5325;
  --gold-2:#c9a75a;
  --gold-3:#fff8e2;
  --gold:linear-gradient(118deg,#7a5b28 0%,#e6cf92 26%,#fff8e2 46%,#d0ac5f 64%,#8a6a2f 100%);
  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
}

*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}

body{
  margin:0;
  min-height:100vh;
  min-height:100dvh;
  background:var(--bg);
  color:var(--ink);
  font-family:var(--sans);
  font-size:15px;
  font-weight:300;
  line-height:1.62;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  padding:
    calc(env(safe-area-inset-top,0px) + 30px)
    calc(env(safe-area-inset-right,0px) + 20px)
    calc(env(safe-area-inset-bottom,0px) + 30px)
    calc(env(safe-area-inset-left,0px) + 20px);
}

body::before,
body::after{
  content:"";
  position:fixed;
  z-index:0;
  pointer-events:none;
  border-radius:50%;
}
body::before{
  top:-260px;left:50%;
  width:620px;height:620px;
  transform:translateX(-50%);
  background:radial-gradient(circle,rgba(201,167,90,.13),rgba(201,167,90,0) 68%);
}
body::after{
  bottom:-320px;left:50%;
  width:700px;height:700px;
  transform:translateX(-50%);
  background:radial-gradient(circle,rgba(138,106,47,.12),rgba(138,106,47,0) 70%);
}

/* ---------- structure ---------- */

.shell{
  position:relative;
  z-index:1;
  width:100%;
  max-width:430px;
  margin:0 auto;
  display:flex;
  flex-direction:column;
}

.brand{text-align:center;margin-bottom:26px}

.brand__eyebrow{
  margin:0 0 10px;
  font-size:10px;
  letter-spacing:.42em;
  text-transform:uppercase;
  color:var(--muted);
}

.brand__title{
  margin:0;
  font-family:var(--serif);
  font-weight:400;
  font-size:clamp(46px,15vw,62px);
  line-height:1;
  letter-spacing:.06em;
  background:var(--gold);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.brand__sub{
  margin:12px 0 0;
  font-size:11px;
  letter-spacing:.24em;
  text-transform:uppercase;
  color:var(--muted);
}

.rail{
  height:1px;
  width:100%;
  background:var(--line-soft);
  margin-bottom:30px;
  overflow:hidden;
}
.rail span{
  display:block;
  height:100%;
  width:16.66%;
  background:var(--gold);
  transition:width .55s cubic-bezier(.3,.9,.3,1);
}

/* ---------- étapes ---------- */

.step{animation:rise .45s cubic-bezier(.2,.8,.2,1) both}

@keyframes rise{
  from{opacity:0;transform:translateY(12px)}
  to{opacity:1;transform:none}
}

.step__index{
  margin:0 0 8px;
  font-size:10px;
  letter-spacing:.3em;
  text-transform:uppercase;
  color:var(--gold-2);
  opacity:.75;
}

.step__title{
  margin:0 0 10px;
  font-family:var(--serif);
  font-weight:400;
  font-size:29px;
  line-height:1.16;
  letter-spacing:.01em;
}

.step__hint{
  margin:0 0 26px;
  font-size:13.5px;
  color:var(--muted);
  line-height:1.66;
}
.step__hint strong{color:var(--ink);font-weight:500}

/* ---------- choix opérateur ---------- */

.choices{display:flex;flex-direction:column;gap:10px}

.choice{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  min-height:56px;
  padding:0 18px;
  font-family:var(--sans);
  font-size:14px;
  font-weight:400;
  letter-spacing:.06em;
  color:var(--ink);
  background:linear-gradient(180deg,rgba(255,255,255,.028),rgba(255,255,255,0));
  border:1px solid var(--line);
  border-radius:2px;
  cursor:pointer;
  transition:border-color .25s,background .25s,transform .18s;
  -webkit-tap-highlight-color:transparent;
}
.choice__arrow{color:var(--gold-2);font-size:19px;line-height:1;opacity:.6}
.choice:active{transform:scale(.988)}
.choice:focus-visible{outline:none;border-color:var(--gold-2);box-shadow:0 0 0 1px rgba(201,167,90,.35)}

@media (hover:hover){
  .choice:hover{border-color:rgba(201,167,90,.5);background:linear-gradient(180deg,rgba(201,167,90,.07),rgba(201,167,90,0))}
  .choice:hover .choice__arrow{opacity:1}
}

/* ---------- formulaire ---------- */

.field{display:block;margin-bottom:6px}

.field__label{
  display:block;
  margin-bottom:8px;
  font-size:10px;
  letter-spacing:.26em;
  text-transform:uppercase;
  color:var(--muted);
}

input{
  display:block;
  width:100%;
  min-height:56px;
  padding:0 16px;
  font-family:var(--sans);
  font-size:16px;
  font-weight:400;
  letter-spacing:.1em;
  color:var(--ink);
  background:rgba(255,255,255,.022);
  border:1px solid var(--line);
  border-radius:2px;
  transition:border-color .25s,background .25s;
  -webkit-appearance:none;
}
input::placeholder{color:rgba(140,135,126,.55);letter-spacing:.1em}
input:focus{outline:none;border-color:var(--gold-2);background:rgba(201,167,90,.045)}
input:-webkit-autofill{-webkit-text-fill-color:var(--ink);-webkit-box-shadow:0 0 0 60px #0b0a0f inset}

.error{
  margin:8px 0 0;
  min-height:16px;
  font-size:12px;
  color:#d98a6a;
  letter-spacing:.02em;
}

/* ---------- boutons ---------- */

.btn{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  min-height:54px;
  padding:0 20px;
  font-family:var(--sans);
  font-size:12px;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  border-radius:2px;
  cursor:pointer;
  transition:transform .18s,opacity .25s,border-color .25s,color .25s;
  -webkit-tap-highlight-color:transparent;
}
.btn:active{transform:scale(.986)}

.btn--primary{
  margin-top:16px;
  color:#0a0805;
  background:var(--gold);
  border:1px solid transparent;
  box-shadow:0 14px 34px -18px rgba(201,167,90,.85);
}
.btn--primary:focus-visible{outline:2px solid var(--gold-3);outline-offset:3px}

.btn--ghost{
  margin-top:10px;
  color:var(--muted);
  background:transparent;
  border:1px solid var(--line-soft);
  letter-spacing:.14em;
  min-height:48px;
  font-weight:400;
}
.btn--ghost:focus-visible{outline:none;border-color:var(--gold-2);color:var(--ink)}

@media (hover:hover){
  .btn--primary:hover{opacity:.92}
  .btn--ghost:hover{border-color:var(--line);color:var(--ink)}
}

/* ---------- compteurs ---------- */

.meter{
  padding:22px 18px;
  border:1px solid var(--line-soft);
  border-radius:2px;
  background:radial-gradient(120% 140% at 50% 0%,rgba(201,167,90,.06),transparent 70%);
}

.meter__time{
  margin:0 0 16px;
  font-family:var(--serif);
  font-size:44px;
  font-weight:300;
  line-height:1;
  letter-spacing:.08em;
  text-align:center;
  font-variant-numeric:tabular-nums;
  background:var(--gold);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.bar{
  height:2px;
  width:100%;
  background:rgba(201,167,90,.14);
  overflow:hidden;
}
.bar__fill{
  display:block;
  height:100%;
  width:0;
  background:var(--gold);
  transition:width .28s linear;
}

.meter__note{
  margin:12px 0 0;
  font-size:10px;
  letter-spacing:.24em;
  text-transform:uppercase;
  text-align:center;
  color:var(--muted);
}

.ticks{
  list-style:none;
  margin:24px 0 0;
  padding:0;
  display:flex;
  flex-direction:column;
  gap:9px;
}
.ticks li{
  position:relative;
  padding-left:20px;
  font-size:12.5px;
  color:var(--muted);
  letter-spacing:.02em;
}
.ticks li::before{
  content:"";
  position:absolute;
  left:0;
  top:8px;
  width:7px;
  height:1px;
  background:var(--gold-2);
  opacity:.7;
}

/* ---------- code final ---------- */

.code-box{
  padding:26px 16px;
  border:1px solid var(--line);
  border-radius:2px;
  background:
    radial-gradient(120% 160% at 50% 0%,rgba(201,167,90,.1),transparent 72%),
    rgba(255,255,255,.015);
  text-align:center;
}

.code-box__value{
  margin:0;
  font-family:var(--serif);
  font-size:clamp(24px,7.6vw,32px);
  font-weight:500;
  letter-spacing:.11em;
  line-height:1.2;
  word-break:break-all;
  font-variant-numeric:tabular-nums;
  background:var(--gold);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  user-select:all;
}

.feedback{
  margin:10px 0 0;
  min-height:15px;
  font-size:12px;
  text-align:center;
  color:var(--gold-2);
  opacity:.85;
}

.recap{
  margin-top:24px;
  border-top:1px solid var(--line-soft);
}
.recap div{
  display:flex;
  justify-content:space-between;
  gap:14px;
  padding:11px 0;
  border-bottom:1px solid var(--line-soft);
  font-size:12.5px;
}
.recap span{color:var(--muted);letter-spacing:.14em;text-transform:uppercase;font-size:10px}
.recap strong{font-weight:400;letter-spacing:.06em}

/* ---------- pied ---------- */

.foot{margin-top:38px;text-align:center}
.foot__line{
  display:block;
  width:34px;
  height:1px;
  margin:0 auto 14px;
  background:var(--line);
}
.foot p{
  margin:0;
  font-size:10px;
  letter-spacing:.26em;
  text-transform:uppercase;
  color:rgba(140,135,126,.7);
}

.noscript{
  margin:0;
  padding:16px;
  text-align:center;
  font-size:13px;
  color:var(--muted);
}

/* ---------- écrans larges ---------- */

@media (min-width:520px){
  body{
    padding-top:calc(env(safe-area-inset-top,0px) + 56px);
    padding-bottom:calc(env(safe-area-inset-bottom,0px) + 56px);
  }
  .step__title{font-size:32px}
}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}
}
